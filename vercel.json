{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/client", "buildCommand": "npm run vercel-build" }
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/api/_worker" }
  ],
  "functions": {
    "api/_worker.*": { "runtime": "edge" }
  }
}
